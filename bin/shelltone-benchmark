#!/usr/bin/env sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
iterations=${1:-50}
case $iterations in *[!0-9]*|'') printf '%s\n' 'usage: shelltone-benchmark [iterations]' >&2; exit 2;; esac

python3 - "$root" "$iterations" <<'PY'
import subprocess, sys, tempfile, time
from pathlib import Path

root, iterations = sys.argv[1], int(sys.argv[2])

def measure(shell, cwd):
    source = f"{root}/shelltone.{shell}"
    if shell == "zsh":
        command = f'SHELLTONE_CONFIG=/dev/null; source {source}; SHELLTONE_GIT_ASYNC=false; SHELLTONE_SHOW_TIME=false; repeat {iterations} {{ _shelltone_set_prompt }}'
        args = [shell, "-f", "-c", command]
    else:
        command = f'SHELLTONE_CONFIG=/dev/null; source {source}; SHELLTONE_GIT_ASYNC=false; SHELLTONE_SHOW_TIME=false; for ((i=0;i<{iterations};i++)); do _shelltone_bash_precmd; done'
        args = [shell, "--noprofile", "--norc", "-c", command]
    start = time.perf_counter()
    subprocess.run(args, cwd=cwd, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return (time.perf_counter() - start) * 1000 / iterations

with tempfile.TemporaryDirectory(prefix="shelltone-benchmark-") as directory:
    large = Path(directory)
    subprocess.run(["git", "init", "-q", "-b", "main", str(large)], check=True)
    subprocess.run(["git", "-C", str(large), "config", "user.name", "Shelltone benchmark"], check=True)
    subprocess.run(["git", "-C", str(large), "config", "user.email", "benchmark@example.invalid"], check=True)
    for index in range(300):
        (large / f"tracked-{index}").write_text("tracked\n")
    subprocess.run(["git", "-C", str(large), "add", "."], check=True, stdout=subprocess.DEVNULL)
    subprocess.run(["git", "-C", str(large), "commit", "-qm", "benchmark fixture"], check=True)
    for index in range(300):
        (large / f"untracked-{index}").write_text("untracked\n")
    cases = [("clean", "/tmp"), ("repository", root), ("large-worktree", str(large))]
    for label, cwd in cases:
        for shell in ("zsh", "bash"):
            print(f"{label}/{shell}: {measure(shell, cwd):.2f} ms/redraw ({iterations} iterations)")
PY
