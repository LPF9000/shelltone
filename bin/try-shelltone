#!/usr/bin/env sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
shell=zsh
if [ "${1-}" = "--shell" ]; then
  shell=${2-}
  shift 2
fi
[ "$#" -eq 0 ] || { printf '%s\n' 'usage: try-shelltone [--shell bash|zsh]' >&2; exit 2; }

case $shell in
  zsh)
    zdot=$(mktemp -d "${TMPDIR:-/tmp}/shelltone-zdot.XXXXXX")
    trap 'rm -rf -- "$zdot"' EXIT HUP INT TERM
    source_config=${SHELLTONE_CONFIG:-$root/config/shelltone.zsh}
    sandbox_config=$zdot/shelltone.zsh
    cp "$source_config" "$sandbox_config"
    ln -s "$root/shelltone-sandbox.zsh" "$zdot/.zshrc"
    SHELLTONE_THEME="$root/shelltone.zsh" SHELLTONE_ROOT="$root" \
      SHELLTONE_CONFIG="$sandbox_config" \
      SHELLTONE_SANDBOX_HISTORY="$zdot/history" ZDOTDIR="$zdot" zsh -d -i
    ;;
  bash)
    bdot=$(mktemp -d "${TMPDIR:-/tmp}/shelltone-bdot.XXXXXX")
    trap 'rm -rf -- "$bdot"' EXIT HUP INT TERM
    source_config=${SHELLTONE_CONFIG:-$root/config/shelltone.zsh}
    sandbox_config=$bdot/shelltone.zsh
    cp "$source_config" "$sandbox_config"
    SHELLTONE_ROOT="$root" SHELLTONE_CONFIG="$sandbox_config" \
      bash --noprofile --rcfile "$root/shelltone-bash-sandbox.sh" -i
    ;;
  *)
    printf '%s\n' 'try-shelltone: --shell must be bash or zsh' >&2
    exit 2
    ;;
esac
