#!/usr/bin/env zsh
emulate -L zsh
setopt err_exit no_unset

local root=${0:A:h:h}
local zdot
zdot=$(mktemp -d ${TMPDIR:-/tmp}/shelltone-zdot.XXXXXX)
function cleanup_shelltone_zdot() {
  rm -rf -- "$zdot"
}
trap 'cleanup_shelltone_zdot; exit 130' HUP INT TERM

# Zsh requires this conventional filename. It exists only in the temporary directory
# for the lifetime of the sandbox; the maintained startup file has a distinct name.
ln -s "$root/shelltone-sandbox.zsh" "$zdot/.zshrc"

setopt no_err_exit
SHELLTONE_THEME="$root/shelltone.zsh" \
SHELLTONE_ROOT="$root" \
SHELLTONE_CONFIG="${SHELLTONE_CONFIG:-$root/config/shelltone.zsh}" \
SHELLTONE_SANDBOX_HISTORY="$zdot/history" \
ZDOTDIR="$zdot" \
zsh -d -i
local child_status=$?
cleanup_shelltone_zdot
exit $child_status
